---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import SideNav from "../components/SideNav.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body>
        <div class="flex flex-col md:flex-row gap-6 md:gap-0 mt-12 md:mt-32 mb-40 max-w-5xl mx-auto px-4">
            <div class="flex flex-row md:flex-col md:w-[200px] shrink-0 gap-6 items-center md:items-start">
                <div
                    class="size-16 rounded-full bg-gray-200"
                    aria-hidden="true"
                >
                    <img
                        class="size-16 rounded-full bg-gray-200 object-cover"
                        src="/mukesh.webp"
                        alt="Mukesh Patel"
                    />
                </div>
                <SideNav />
            </div>
            <main class="flex flex-col flex-1 min-w-0 gap-6 items-start">
                <div class="h-16 flex items-center text-xl font-semibold">
                    Mukesh Patel
                </div>
                <slot />
                <Footer />
            </main>
        </div>
    </body>
</html>
